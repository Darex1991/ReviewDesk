# GENERAL
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGIN=https://app.reviewdesk.localhost
COOKIE_DOMAIN=reviewdesk.localhost
EMAIL_ADAPTER=mailhog

# DATABASE
DATABASE_URL=postgres://postgres:reviewdesk@localhost:5432/reviewdesk
DATABASE_TEST_URL=postgres://postgres:reviewdesk@localhost:5432/reviewdesk_test
REDIS_URL=redis://localhost:6379
BULLBOARD_PASSWORD=admin123

# MAILS
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# AWS
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true

FILE_STORAGE_ADAPTER=s3
AWS_BUCKET_NAME=reviewdesk-uploads


# AUTH

BETTER_AUTH_SECRET=secret99secret99secret99secret99secret99
BETTER_AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=1111111111111-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-example123



# AI REVIEW
# anthropic | mock | disabled
AI_REVIEW_ADAPTER=mock
ANTHROPIC_API_KEY=
AI_REVIEW_MODEL=claude-opus-5
# low | medium | high | xhigh | max
AI_REVIEW_EFFORT=high
AI_REVIEW_MAX_INPUT_CHARS=200000
AI_REVIEW_MAX_BATCHES=3
